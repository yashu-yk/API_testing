              "script": {
                "type": "text/javascript",
                "exec": [
                  "// validating json fields in the response\r\n\r\npm.test(\"Value of fields in response\", ()=>{\r\n    pm.expect(pm.response.json().id).to.equals(pm.environment.get(\"goRestId\"));\r\n    pm.expect(pm.response.json().name).to.equals(pm.environment.get(\"username_env\"));\r\n    pm.expect(pm.response.json().email).to.equals(pm.environment.get(\"useremail_env\"));\r\n});"
