                "exec": [
                  "// 7b0522483c9c57ae06667baf2275ecc4a8e1a62a8d1700634765770ddb4f0672\r\n\r\nconst jsonData=pm.response.json();\r\npm.environment.set(\"goRestId\",jsonData.id);\r\n\r\n"
