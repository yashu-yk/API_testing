            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const random=Math.random().toString(36).substring(2);\r\n\r\nconst useremail = \"a\" + random + \"@gmail.com\";\r\nconst username = \"a\" + random;\r\n\r\npm.environment.set(\"useremail_env\", useremail);\r\npm.environment.set(\"username_env\", username);"
                ]
              }
            }
